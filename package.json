{
  "name": "attunement",
  "version": "0.3.0",
  "description": "Typed, validated runtime config for SPAs. The app attunes to its environment before first render.",
  "keywords": [
    "runtime-config",
    "config",
    "app-config",
    "zod",
    "standard-schema",
    "react",
    "vite",
    "spa"
  ],
  "license": "MIT",
  "author": "Josef Kvapil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wraithyy/attunement.git"
  },
  "homepage": "https://github.com/wraithyy/attunement#readme",
  "bugs": "https://github.com/wraithyy/attunement/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "default": "./dist/devtools.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "bin": {
    "attunement": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@standard-schema/spec": "^1.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.2.8",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.1.5",
    "vitest": "^3.0.0",
    "zod": "^3.24.0"
  }
}
